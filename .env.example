# Database
DATABASE_URL="postgresql://vegan:vegan@127.0.0.1:5433/vegan_university"
# Session-mode connection for migrations only. Prisma Migrate hangs
# through a transaction-mode pooler. Locally this is the same as above.
DIRECT_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Transactional email (Resend). Put the live key only in local .env — never commit it.
RESEND_API_KEY=
# Must be a Resend-verified sender. Gmail cannot be used as From until a domain is verified.
# Resend's test sender works in development: Vegan University <onboarding@resend.dev>
EMAIL_FROM="Vegan University <onboarding@resend.dev>"

# Optional rate limiting. Without these, an in-memory limiter is used in development only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observability (optional until Phase 6/7)
# Sentry. The DSN is public by design (every browser receives it). Leave it
# empty and Sentry is simply off. SENTRY_AUTH_TOKEN is a secret: set it only
# as a server/build variable, never NEXT_PUBLIC_; without it builds skip the
# source-map upload and nothing else changes.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
# SENTRY_ORG="cinnamon-snail"
# SENTRY_PROJECT="javascript-nextjs"
# PostHog. The project token is public by design. Empty means analytics off.
# (NEXT_PUBLIC_POSTHOG_KEY is still read as a fallback name.)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Web push. Generate a pair once with `npx web-push generate-vapid-keys`.
# The public key is sent to browsers; the private key signs every push and is
# a secret. Without both, push is simply off. VAPID_SUBJECT is the contact
# address push services may use (mailto: or https:).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:hello@your-domain"
# Job routes (/api/jobs/*, including the notification retry sweep) need one of
# these in production or they refuse every request. Vercel Cron sends
# CRON_SECRET automatically.
# CRON_SECRET=""

# Do not put SamCart/Kit secrets in client code. Put live values only in local .env.
SAMCART_WEBHOOK_SECRET=""
SAMCART_API_KEY=""
SAMCART_API_BASE="https://api.samcart.com/v1"
# Where the daily billing reconciliation email goes (sent every day, clean or
# not). Falls back to EMAIL_FROM, which is a sender address, so set this.
BILLING_ALERT_EMAIL=""
# The AI cohost (BUILD.md §16). Groq is used when GROQ_API_KEY is set, Claude
# otherwise; with neither the cohost writes nothing, while the approval queue
# and publishing still work. GROQ_MODEL / ANTHROPIC_MODEL override the defaults.
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
KIT_API_KEY=""
KIT_API_SECRET=""
KIT_API_BASE="https://api.convertkit.com/v3"
# Both keys are used by billing's product tags and by the roadmap sync
# (lib/roadmap/kit-sync.ts). Without them the roadmap sync records "Kit is not
# configured" and sends nothing. After first setting them, run once:
#   curl -X POST -H "authorization: Bearer $CRON_SECRET" "$AUTH_URL/api/jobs/kit-roadmap?backfill=1"
# Shared by every /api/jobs/* cron endpoint, not just billing (see
# lib/jobs/auth.ts). CRON_SECRET is accepted as a fallback because that is what
# Vercel Cron sets. Without either, the job routes are open in development and
# closed in production.
BILLING_JOB_SECRET=""
BILLING_ALERT_EMAIL=""
# Live Classes from Zoom (DEC-079). A Zoom Server-to-Server OAuth app with the
# meeting:read scopes. Without these the sync records "Zoom is not configured"
# and changes nothing; staff can still add live classes by hand.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Whose meetings to read: comma-separated Zoom user ids or emails. "me" is the
# app owner's own account.
ZOOM_USER_IDS="me"
# From the app's Feature page, for the optional webhook at /api/webhooks/zoom
# (meeting.created / updated / deleted), so changes arrive as they happen.
# Without it the daily sync, and the hourly refresh when a member opens Live
# Classes, still pick them up.
ZOOM_WEBHOOK_SECRET_TOKEN=""
# Crews from the RightMessage survey (DEC-078). By default the crews job reads
# the client's own Kit fields: gluten_free ("true") → Gluten-Free Gang, and
# rm_audience_segment (else audience_segment) "advanced" / "new" → Advanced
# Cooking Crew / Nooch Newbies. Override a trait only if those fields change:
#   trait                       keep the default for that trait
#   trait=field                 field answered yes-like
#   trait=field:value|value     field holds one of these values
# KIT_SURVEY_FIELDS="gf=gluten_free,advanced=rm_audience_segment:advanced,new=rm_audience_segment:new"
# DEC-010: 7-day grace after a confirmed deletion request, then purge.
ACCOUNT_DELETION_GRACE_DAYS="7"

# Phase 3 video (DEC-014). Without Stream keys, demo lessons use expiring app tokens.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=

# Course video on Bunny Stream (DEC-081). Server-side only: none of these may
# ever be read by client code. LIBRARY_ID + API_KEY manage videos (upload,
# list, delete). TOKEN_KEY is the library's "Token Authentication Key" from
# Bunny's Security settings; with Embed view token authentication switched on
# there, it is what signs each member's player link. Without TOKEN_KEY,
# production refuses to hand out Bunny links at all.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_TOKEN_KEY=""
# Local testing only, against a library without token auth: "1" allows
# unsigned player links. Ignored on Vercel production.
# BUNNY_STREAM_ALLOW_UNSIGNED="1"

# Member uploads (photos and video on posts). Uploads stay disabled until both
# of the first two are set. See docs/member-uploads.md for the bucket policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=community-uploads

# Social sign-in. Each provider appears on the login page only when both of its
# variables are set, so a deployment without them shows no button rather than a
# button that fails when pressed.
# Google: console.cloud.google.com -> Credentials -> OAuth client (Web).
#   Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook: developers.facebook.com -> your app -> Facebook Login -> Settings.
#   Redirect URI: {AUTH_URL}/api/auth/callback/facebook
#   Note: Facebook requires app review before it will serve public users.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# GIF search in the composer. Without it the GIF button hides itself and
# everything else in the editor still works.
#   Get a key: https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=""
