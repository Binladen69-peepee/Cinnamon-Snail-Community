# Database
DATABASE_URL="postgresql://vegan:vegan@127.0.0.1:5433/vegan_university"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Transactional email (Resend). Put the live key only in local .env — never commit it.
RESEND_API_KEY=
# Must be a Resend-verified sender. Gmail cannot be used as From until a domain is verified.
# Resend's test sender works in development: Vegan University <onboarding@resend.dev>
EMAIL_FROM="Vegan University <onboarding@resend.dev>"

# Optional rate limiting. Without these, an in-memory limiter is used in development only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observability (optional until Phase 6/7)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Do not put SamCart/Kit secrets in client code. Put live values only in local .env.
SAMCART_WEBHOOK_SECRET=""
SAMCART_API_KEY=""
SAMCART_API_BASE="https://api.samcart.com/v1"
KIT_API_KEY=""
KIT_API_SECRET=""
KIT_API_BASE="https://api.convertkit.com/v3"
BILLING_JOB_SECRET=""
BILLING_ALERT_EMAIL=""
# DEC-010: 7-day grace after a confirmed deletion request, then purge.
ACCOUNT_DELETION_GRACE_DAYS="7"

# Phase 3 video (DEC-014). Without Stream keys, demo lessons use expiring app tokens.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=

# Member uploads (photos and video on posts). Uploads stay disabled until both
# of the first two are set. See docs/member-uploads.md for the bucket policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=community-uploads
